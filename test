/*Vamos a modelar una clase Persona que tenga propiedades básicas como
nombre, edad y correo electrónico. Además, tendrá métodos para
saludar, actualizar el correo y mostrar un resumen de la persona. */


class datos {
    nombre: string;
    edad: number;
    correo: string;
  
    // Constructor para inicializar los atributos
    constructor(nombre: string, edad: number, correo: string) {
      this.nombre = nombre;
      this.edad = edad;
      this.correo = correo;
    }
  
    // Método para mostrar información de la persona
    saludar(): void {
      console.log(
        `Hola, me llamo ${this.nombre}, tengo ${this.edad} años y mi correo electrónico es ${this.correo}.`
      );
    }
  
    // Método para mostrar un resumen de la persona
    mostrarResumen(): void {
      console.log(
        `Resumen: Nombre: ${this.nombre}, Edad: ${this.edad}, Correo: ${this.correo}.`
      );
    }
  }
  
  // Crear un objeto (instancia) de la clase Datos
  const datos4 = new datos("Manu", 19, "manu@gmail.com");
  
  // Usar los métodos del objeto creado
  datos4.saludar(); // Hola, me llamo Manu, tengo 19 años y mi correo electrónico es manu@gmail.com.
  datos4.mostrarResumen(); // Resumen: Nombre: Manu, Edad: 19, Correo: manu@gmail.com.
